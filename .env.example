# ==========================================
# Apex Corporate Workspace Environment Configuration
# ==========================================

# Application Environment
FLASK_ENV=development
PORT=5000

# Security Secrets (Generate secure random tokens in production)
SECRET_KEY=change-this-in-production-to-a-random-secret-key-32-bytes
JWT_SECRET_KEY=change-this-in-production-to-a-random-jwt-secret-key-32-bytes

# Database Configuration (MySQL 8.0)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=devplatform
MYSQL_USER=apexuser
MYSQL_PASSWORD=apexpassword
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Database Connection URI (SQLAlchemy format)
# For MySQL:
DATABASE_URL=mysql+pymysql://apexuser:apexpassword@localhost:3306/devplatform
# For Zero-Config SQLite local development fallback:
# DATABASE_URL=sqlite:///devplatform.db

# File Storage
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=52428800 # 50 MB

# Real-time WebSockets & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
